// -- public contract surface predicates --
predicate NonzeroSpan(s: int)   { s != 0 }
predicate PositiveWhole(w: int) { w > 0 }

method Percent(part: int, whole: int) returns (r: int)
  requires PositiveWhole(whole)
  ensures  r == part * 100 / whole
{ r := part * 100 / whole; }

method Ratio(x: int) returns (r: int)
  ensures r == x * 100 / 4
{ r := Percent(x, 4); }

// -- implementation behavior realization --
method Trend(delta: int, span: int) returns (r: int)
