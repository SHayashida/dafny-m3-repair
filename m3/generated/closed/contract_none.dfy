// -- public contract surface predicates --
predicate PositiveSpan(s: int)  { s > 0 }
predicate NonzeroWhole(w: int)  { w != 0 }

method Percent(part: int, whole: int) returns (r: int)
  requires NonzeroWhole(whole)
  ensures  r == part * 100 / whole
{ r := part * 100 / whole; }

method Ratio(x: int) returns (r: int)
  ensures r == x * 100 / 4
{ r := Percent(x, 4); }

// -- implementation behavior realization --
method Trend(delta: int, span: int) returns (r: int)
  requires PositiveSpan(span)
{
  if PositiveSpan(span) { r := Percent(delta, span); }
  else                  { r := 0; }
}

method TrendUserOK(d: int, s: int) returns (r: int)
  requires s > 0
{ r := Trend(d, s); }

method TrendUserNonzero(d: int, s: int) returns (r: int)
  requires s != 0
{ r := Trend(d, s); }
